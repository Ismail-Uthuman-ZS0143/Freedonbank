# Copy to .env and fill in real values. Do not commit .env.

DJANGO_DEBUG=true
SESSION_SECRET=

PGDATABASE=fbv
PGUSER=
PGPASSWORD=
PGHOST=
PGPORT=5432

UPLOAD_STORAGE_ROOT=

FRONTEND_BASE_URL=http://localhost:3005

# Real outbound email delivery -- direct-to-MX (no SMTP relay/provider
# account). Fails closed by design: MAIL_ALLOWED_DOMAINS only allows what's
# listed below, every other recipient domain is blocked with no send
# attempted at all.
MAIL_ENABLED=true
MAIL_FROM_ADDRESS=requests@freedombankva.com
MAIL_FROM_NAME=Freedom Bank of Virginia
MAIL_ALLOWED_DOMAINS=
MAIL_SMTP_PORT=25
# Set to host:port to route all outbound mail to a local test SMTP server instead of real MX
MAIL_TEST_SERVER=
MAIL_TIMEOUT_SECONDS=10
MAIL_DNS_TIMEOUT_SECONDS=5

# Authenticated relay override -- takes over delivery entirely when all
# three are set. Only needed in an environment where direct-to-MX (port 25
# egress) isn't reachable; leave unset once deployed somewhere port 25 is
# reachable, so direct-to-MX (above) is used.
MAIL_RELAY_HOST=
MAIL_RELAY_PORT=587
MAIL_RELAY_USERNAME=
MAIL_RELAY_PASSWORD=
